rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'faycalassoul@gmail.com'
      );
    }

    // --- User Documents ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    match /users {
      allow list: if isSignedIn();
    }

    // --- Registered Schools Directory (Multi-Tenant Linking) ---
    match /registered_schools/{schoolId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /registered_schools {
      allow list: if true;
    }

    // --- Shared School Data (all subcollections and documents) ---
    match /schools/{schoolId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    match /schools/{id} {
      allow read, write: if isSignedIn();
    }
    
    match /school_metadata/{allPaths=**} {
      allow read: if true;
    }

    // --- Settings Profile & Shared School Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /settings {
      allow list: if true;
    }

    // --- Teachers Directory ---
    match /teachers/{id} {
      allow read, write: if isSignedIn();
    }
    match /teachers {
      allow list: if isSignedIn();
    }

    // Public National Legislation (Shared official decrees, circulars and laws across all schools)
    match /public_legislation/{id} {
      allow read, write: if isSignedIn();
    }
    match /public_legislation {
      allow list: if isSignedIn();
    }

    // Resilient file storage chunks for PDFs
    match /stored_blobs/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // User administrative documents & correspondence
    match /user_admin_documents/{id} {
      allow read, write: if isSignedIn();
    }
    match /user_admin_documents {
      allow list: if isSignedIn();
    }

    // Global Collections
    match /support_tickets/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /support_tickets {
      allow list: if isAdmin();
    }

    match /purchase_requests/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /purchase_requests {
      allow list: if isAdmin();
    }

    // Connection Test
    match /_connection_test_/{id} {
      allow read, write: if isSignedIn();
    }

    match /diagnostics_log/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Root level data collections fallback for backward compatibility
    match /chemicals/{id} {
      allow read, write: if isSignedIn();
    }
    match /equipment/{id} {
      allow read, write: if isSignedIn();
    }
    match /reports/{id} {
      allow read, write: if isSignedIn();
    }
    match /experiment_logs/{id} {
      allow read, write: if isSignedIn();
    }
    match /safety_incidents/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
