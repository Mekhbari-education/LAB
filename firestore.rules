rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verified Project Owner ONLY (Faycalassoul@gmail.com)
    function isProjectOwner() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'faycalassoul@gmail.com';
    }

    // Delegated public legislation admin OR project owner
    function isAdmin() {
      return isProjectOwner() || (isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() && (
        isProjectOwner() ||
        (hasUserDoc() && getUserDoc().schoolId == schoolId) ||
        (request.auth.uid == schoolId)
      );
    }

    // --- Trusted Admin Directory (Managed exclusively by Project Owner) ---
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isProjectOwner();
      allow list: if isProjectOwner();
      allow write: if isProjectOwner();
    }

    // --- User Documents (PII Protection & Owner-Only Central Control) ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isProjectOwner();
      allow list: if isProjectOwner();

      allow create: if isOwner(userId) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('roleOverride' in request.resource.data)) &&
        (!('disabled' in request.resource.data) || request.resource.data.disabled == false) &&
        (!('role' in request.resource.data) || !(request.resource.data.role in ['Admin', 'admin']) || isProjectOwner());

      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role', 'roleOverride', 'disabled'])) ||
        isProjectOwner();

      allow delete: if isProjectOwner();
    }

    // --- Registered Schools Directory ---
    match /registered_schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSchoolMember(schoolId) || isProjectOwner();
    }
    match /registered_schools {
      allow list: if isSignedIn();
    }

    // --- Owner-Only CollectionGroup Access for System Oversight ---
    match /{path=**}/logs/{logId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/purchase_orders/{orderId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/chemicals/{itemId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/equipment/{itemId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/safety_incidents/{itemId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/experiment_logs/{itemId} {
      allow read: if isProjectOwner();
    }
    match /{path=**}/reports/{itemId} {
      allow read: if isProjectOwner();
    }

    // --- Global System Config (Feature Flags, Maintenance Mode, Policy Overrides) ---
    match /system_config/{configId} {
      allow get: if configId == 'global' || isProjectOwner();
      allow list: if isProjectOwner();
      allow write: if isProjectOwner();
    }

    // --- Immutable Owner Audit Trail ---
    match /admin_audit_logs/{logId} {
      allow read, create: if isProjectOwner();
      allow update, delete: if false;
    }

    // --- School-Scoped Isolated Data (All Subcollections: chemicals, equipment, etc.) ---
    match /schools/{schoolId}/{allPaths=**} {
      allow read, write: if isSchoolMember(schoolId);
    }
    match /schools/{schoolId} {
      allow read, write: if isSchoolMember(schoolId);
    }

    match /school_metadata/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolMember(schoolId) || isProjectOwner();
    }

    // --- Settings Profiles (School Settings & User Calibration) ---
    match /settings/{settingId} {
      allow read: if isSignedIn() && (isOwner(settingId) || isSchoolMember(settingId) || isProjectOwner());
      allow write: if isSignedIn() && (isOwner(settingId) || isSchoolMember(settingId) || isProjectOwner()) &&
        ((!('role' in request.resource.data) || !(request.resource.data.role in ['Admin', 'admin']) || isProjectOwner()) &&
         (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isProjectOwner()));
    }
    match /settings {
      allow list: if isProjectOwner();
    }

    // --- Teachers Directory ---
    match /teachers/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isProjectOwner() || (resource != null && 'schoolId' in resource.data ? isSchoolMember(resource.data.schoolId) : true));
    }
    match /teachers {
      allow list: if isSignedIn();
    }

    // --- Public National Legislation (Read by authenticated school staff, write by Admin/Owner) ---
    match /public_legislation/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /public_legislation {
      allow list: if isSignedIn();
    }

    // --- Platform Announcements (Managed exclusively by Project Owner) ---
    match /system_announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isProjectOwner();
    }

    // --- Resilient PDF File Storage Chunks ---
    match /stored_blobs/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- User Administrative Documents & Correspondence ---
    match /user_admin_documents/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (('schoolId' in resource.data) && isSchoolMember(resource.data.schoolId)) ||
        isProjectOwner()
      );
    }
    match /user_admin_documents {
      allow list: if isSignedIn();
    }

    // --- Support Tickets & Purchase Requests ---
    match /support_tickets/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isProjectOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /support_tickets {
      allow list: if isProjectOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /purchase_requests/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isProjectOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /purchase_requests {
      allow list: if isProjectOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Connection Test & Diagnostics ---
    match /_connection_test_/{id} {
      allow read, write: if isSignedIn();
    }

    match /diagnostics_log/{id} {
      allow create: if isSignedIn();
      allow get: if isProjectOwner() || (isSignedIn() && resource.data.testBy == request.auth.token.email);
      allow list, update, delete: if isProjectOwner();
    }

    // --- Fallback Root Collections (Scoped by school membership) ---
    match /chemicals/{id} {
      allow read, write: if isSchoolMember(id) || isProjectOwner();
    }
    match /equipment/{id} {
      allow read, write: if isSchoolMember(id) || isProjectOwner();
    }
    match /reports/{id} {
      allow read, write: if isSchoolMember(id) || isProjectOwner();
    }
    match /experiment_logs/{id} {
      allow read, write: if isSchoolMember(id) || isProjectOwner();
    }
    match /safety_incidents/{id} {
      allow read, write: if isSchoolMember(id) || isProjectOwner();
    }
  }
}
