{
  "entities": {
    "chemical": {
      "title": "Chemical Entity",
      "description": "Represents a chemical substance in the laboratory inventory.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Common name of the chemical" },
        "formula": { "type": "string", "description": "Chemical formula" },
        "casNumber": { "type": "string", "description": "CAS Registry Number" },
        "concentration": { "type": "string", "description": "Concentration/Purity" },
        "quantity": { "type": "number", "description": "Current quantity" },
        "unit": { "type": "string", "description": "Unit of measurement (g, ml, etc.)" },
        "location": { "type": "string", "description": "Storage location" },
        "hazardClass": { "type": "string", "description": "Hazard classification" },
        "expiryDate": { "type": "string", "format": "date", "description": "Expiry date" },
        "ghs": { "type": "array", "items": { "type": "string" }, "description": "GHS pictograms" },
        "updatedAt": { "type": "object", "description": "Firestore server timestamp" }
      },
      "required": ["name", "quantity", "unit"]
    },
    "equipment": {
      "title": "Equipment Entity",
      "description": "Represents laboratory tools, glassware, or technical devices.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["glassware", "tech", "other"] },
        "serialNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["functional", "maintenance", "broken"] },
        "totalQuantity": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "brokenQuantity": { "type": "number" },
        "location": { "type": "string" },
        "updatedAt": { "type": "object" }
      },
      "required": ["name", "type", "status", "totalQuantity"]
    },
    "teacher": {
      "title": "Teacher Entity",
      "description": "Information about teachers using the laboratory.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name"]
    },
    "activity_request": {
      "title": "Activity Request Entity",
      "description": "A request made by a teacher to prepare a laboratory activity.",
      "type": "object",
      "properties": {
        "teacherName": { "type": "string" },
        "activityTitle": { "type": "string" },
        "executionDate": { "type": "string", "format": "date" },
        "timing": { "type": "string" },
        "equipItems": { "type": "array" },
        "chemItems": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["teacherName", "activityTitle"]
    },
    "loan_request": {
      "title": "Loan Request Entity",
      "description": "A request for borrowing equipment.",
      "type": "object",
      "properties": {
        "teacherName": { "type": "string" },
        "items": { "type": "array" },
        "requestDate": { "type": "string", "format": "date" },
        "returnDate": { "type": "string", "format": "date" }
      }
    },
    "settings": {
      "title": "User Settings Entity",
      "description": "User profile and institution settings.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "school": { "type": "string" },
        "directorate": { "type": "string" },
        "commune": { "type": "string" },
        "jobTitle": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "levels": { "type": "array" }
      }
    },
    "log": {
      "title": "Activity Log Entity",
      "description": "System usage logs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    },
    "legislation": {
      "title": "Legislation Entity",
      "description": "School legislation documents, circulars, decrees, and laws.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "reference": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "storageType": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "category"]
    },
    "system_announcement": {
      "title": "System Announcement Entity",
      "description": "Platform-wide ministerial and technical announcements published by the project owner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string", "enum": ["urgent", "technical", "pedagogical", "update"] },
        "priority": { "type": "string", "enum": ["normal", "high"] },
        "authorName": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "message"]
    },
    "diagnostic_log": {
      "title": "Diagnostic Log Entity",
      "description": "Firestore connectivity and client diagnostic test entries.",
      "type": "object",
      "properties": {
        "testBy": { "type": "string" },
        "message": { "type": "string" },
        "databaseId": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "object" }
      }
    },
    "purchase_order": {
      "title": "Purchase Order Entity",
      "description": "Laboratory budget purchase order per school.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "schoolName": { "type": "string" },
        "supplierName": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "items": { "type": "array" },
        "createdAt": { "type": "object" }
      }
    },
    "delegated_admin": {
      "title": "Delegated Legislation Admin Entity",
      "description": "Owner-managed delegated legislation administrator records.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "grantedBy": { "type": "string" },
        "updatedAt": { "type": "object" }
      }
    },
    "system_config": {
      "title": "Global System Configuration Entity",
      "description": "Platform-wide maintenance mode, feature flags, and dynamic role route overrides.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "maintenanceEta": { "type": "string" },
        "readOnlyMode": { "type": "boolean" },
        "enforceStatutorySetup": { "type": "boolean" },
        "features": { "type": "object" },
        "roleRouteOverrides": { "type": "object" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "object" }
      }
    },
    "admin_audit_log": {
      "title": "Owner Audit Log Entity",
      "description": "Immutable audit trail of central admin actions executed by the project owner.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorEmail": { "type": "string" },
        "targetType": { "type": "string" },
        "targetIds": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "object" }
      }
    },
    "safety_incident": {
      "title": "Safety Incident Entity",
      "description": "Laboratory safety incidents and resolutions per school.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  },
  "firestore": {
    "schools/{userId}/chemicals": {
      "schema": "chemical",
      "description": "User-isolated chemical inventory."
    },
    "schools/{userId}/equipment": {
      "schema": "equipment",
      "description": "User-isolated equipment inventory."
    },
    "schools/{userId}/legislation": {
      "schema": "legislation",
      "description": "User-isolated school legislation documents."
    },
    "schools/{userId}/teachers": {
      "schema": "teacher",
      "description": "User-isolated teacher list."
    },
    "schools/{userId}/activity_requests": {
      "schema": "activity_request",
      "description": "User-isolated activity requests."
    },
    "schools/{userId}/loan_requests": {
      "schema": "loan_request",
      "description": "User-isolated loan requests."
    },
    "schools/{userId}/logs": {
      "schema": "log",
      "description": "User-isolated activity logs (queryable by project owner via collectionGroup)."
    },
    "schools/{userId}/purchase_orders": {
      "schema": "purchase_order",
      "description": "School-isolated purchase orders (queryable by project owner via collectionGroup)."
    },
    "schools/{userId}/safety_incidents": {
      "schema": "safety_incident",
      "description": "School-isolated safety incidents (queryable by project owner via collectionGroup)."
    },
    "settings/{userId}": {
      "schema": "settings",
      "description": "User-isolated settings profile."
    },
    "users/{userId}": {
      "schema": "settings",
      "description": "User profile, role, and account status."
    },
    "admins/{adminId}": {
      "schema": "delegated_admin",
      "description": "Delegated public legislation editors managed exclusively by the project owner."
    },
    "system_announcements/{announcementId}": {
      "schema": "system_announcement",
      "description": "Targeted platform announcements managed exclusively by the project owner."
    },
    "system_config/{configId}": {
      "schema": "system_config",
      "description": "Global platform configuration, feature flags, and maintenance mode controlled exclusively by the project owner."
    },
    "admin_audit_logs/{logId}": {
      "schema": "admin_audit_log",
      "description": "Immutable owner governance audit trail."
    },
    "diagnostics_log/{diagnosticId}": {
      "schema": "diagnostic_log",
      "description": "Client diagnostic test records readable across all entries only by the project owner."
    }
  }
}
